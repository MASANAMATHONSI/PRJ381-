<% 
  const currentBattery = typeof batteryLevel !== 'undefined' ? Number(batteryLevel) : 87;
  const batteryPercent = Math.min(Math.max(currentBattery, 0), 100);

  let batteryColorClass = 'battery-green';
  if (currentBattery <= 20) {
    batteryColorClass = 'battery-red';
  } else if (currentBattery <= 50) {
    batteryColorClass = 'battery-amber';
  }
%>

<link rel="stylesheet" href="/css.css" />

<!-- Top Navigation Bar -->
<header class="iwos-topbar">
  <button type="button" id="menuToggle" class="nav-btn" aria-label="Open Navigation">
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
  </button>

  <div class="topbar-title-group">
    <div class="brand-badge-row">
      <span class="brand-square"></span>
      <span class="badge-text">IWOS FIELD</span>
    </div>
    <h1 class="topbar-title">
      <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Telemetry Dashboard' %>
    </h1>
  </div>
</header>

<div id="drawerOverlay" class="drawer-overlay"></div>

<!-- Sidebar Drawer -->
<aside id="sidebarDrawer" class="sidebar-drawer">
  <div class="drawer-header">
    <div class="brand-badge-row">
      <span class="brand-square"></span>
      <span class="badge-text">IWOS FIELD</span>
    </div>
    <button type="button" id="closeDrawer" class="close-btn" aria-label="Close Navigation">&times;</button>
  </div>

  <nav class="sidebar-nav" aria-label="Main Navigation">
    <!-- 1. Dashboard -->
    <a 
      href="/dashboard" 
      class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'active' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 3h7v7H3V3zm11 0h7v7h-7V3zm-11 11h7v7H3v-7zm11 0h7v7h-7v-7z"/>
      </svg>
      <span>Live Status</span>
    </a>

    <!-- 2. Sync & Sessions -->
    <a 
      href="/sync-sessions" 
      class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'sync') ? 'active' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.3"/>
      </svg>
      <span>Sync &amp; Logs</span>
    </a>

    <!-- 3. Route Set Up -->
    <a 
      href="/route-setup" 
      class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'route-setup') ? 'active' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
      </svg>
      <span>Route Setup</span>
    </a>

    <!-- 4. Register -->
    <a 
      href="/register" 
      class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'register') ? 'active' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="8.5" cy="7" r="4"></circle>
        <line x1="20" y1="8" x2="20" y2="14"></line>
        <line x1="23" y1="11" x2="17" y2="11"></line>
      </svg>
      <span>Register</span>
    </a>

    <!-- 5. Sign Up -->
    <a 
      href="/signup" 
      class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'signup') ? 'active' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
        <polyline points="10 17 15 12 10 7"></polyline>
        <line x1="15" y1="12" x2="3" y2="12"></line>
      </svg>
      <span>Sign Up</span>
    </a>
  </nav>

  <!-- Responsive Battery Footer Card -->
  <div class="sidebar-footer-card">
    <div class="card-top-row">
      <div class="vehicle-identity">
        <strong class="vehicle-code">IWOS-07</strong>
        <span class="lead-pill">LEAD</span>
      </div>

      <div id="batteryWidget" class="battery-metric <%= batteryColorClass %>">
        <div class="battery-meter" title="<%= batteryPercent %>%">
          <div class="battery-meter-body">
            <div 
              id="batteryFillBar" 
              class="battery-meter-fill" 
              data-percent="<%= batteryPercent %>"
            ></div>
          </div>
          <div class="battery-meter-nipple"></div>
        </div>
        <span id="batteryValueText" class="battery-value"><%= currentBattery %>%</span>
      </div>
    </div>
    
    <div class="status-divider"></div>

    <div class="card-bottom-row">
      <span class="pulse-dot"></span>
      <span class="status-label">Operating Normal</span>
    </div>
  </div>
</aside>